				item: { Count: 8, id: "minecraft:iron_ingot" }
				type: "item"
			}]
			title: "The First Fire"
			x: -4.0d
			y: 0.0d
		}
		{
			dependencies: ["1000000000000003"]
			description: [
				"Iron. The backbone of every civilization that ever rose."
				""
				"The old researchers began here too, though their minds were already drifting toward atoms and dimensions. But you know better. Every tower begins with a single ingot. Every network begins with a single connection."
				""
				"Stockpile what you need. The real work is about to begin."
			]
			icon: "minecraft:iron_block"
			id: "1000000000000004"
			rewards: [{
				id: "3000000000000005"
				type: "xp"
				xp: 150
			}]
			shape: "square"
			subtitle: "The backbone of every civilization."
			tasks: [{
