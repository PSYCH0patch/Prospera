				title: "Iron Plates"
				type: "item"
			}]
			title: "The Weight of Power"
			x: 0.5773809523809703d
			y: -1.25d
		}
		{
			dependencies: ["1000000000000006"]
			description: [
				"Copper carries energy. This was one of the first truths the old researchers discovered, and one of the few that survived intact across the centuries of forgetting."
				""
				"Whether you draw it into wires, press it into plates, or cast it into coils — copper is the thread that will eventually connect every machine to every other."
				""
				"Begin gathering it now."
			]
			icon: "minecraft:copper_ingot"
			id: "1000000000000008"
			rewards: [{
				id: "3000000000000009"
				type: "xp"
				xp: 200
