			y: -2.0d
		}
		{
			dependencies: ["1000000000000004"]
			description: [
				"Steel is the language of industry. Every beam, every gear, every pipe that once held a civilization together was forged from steel."
				""
				"The old researchers had seventeen different methods of producing it, each optimized for a different purpose."
				""
				"You do not need seventeen. You need one that works. Produce enough to prove that industry can return."
			]
			icon: "minecraft:anvil"
