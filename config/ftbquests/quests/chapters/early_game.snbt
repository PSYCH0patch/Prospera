	quests: [
		{
			description: [
				"You open your eyes to a world that feels... empty. Not barren — the trees grow, the rivers flow. But there is a silence beneath it all, as if something vast once filled this space and no longer does."
				""
				"You do not yet know what was lost."
				""
				"Begin with what you know. The trees are the same. The stone is the same. The world has moved on, even if its history has not."
			]
			icon: "minecraft:oak_log"
			id: "1000000000000001"
			rewards: [{
				id: "3000000000000001"
				type: "xp"
				xp: 50
			}]
			shape: "square"
			subtitle: "The silence of a world that has forgotten."
			tasks: [{
				id: "24DD538798A23271"
				item: "minecraft:oak_log"
				type: "item"
			}]
			title: "A Quiet World"
			x: -8.0d
			y: 0.0d
		}
		{
			dependencies: ["1000000000000001"]
			description: [
				"Your hands shape stone into tools. Simple. Effective. The same gestures humans have made for millennia."
				""
				"But somewhere in the back of your mind, a question forms: was this always the limit?"
				""
				"The old civilization began here too, with stone and patience, before they reached for forces that could split the sky."
			]
			icon: {
				Count: 1
				id: "minecraft:stone_pickaxe"
				tag: {
					Damage: 0
				}
			}
			id: "1000000000000002"
			rewards: [{
				id: "3000000000000002"
				type: "xp"
				xp: 50
			}]
			shape: "square"
			subtitle: "The oldest gesture of human hands."
			tasks: [{
				id: "2000000000000002"
				item: {
					Count: 1
					id: "minecraft:stone_pickaxe"
					tag: {
						Damage: 0
					}
				}
				title: "Any Stone Tool"
				type: "item"
			}]
			title: "Stone Remembers"
			x: -6.0d
			y: 0.0d
		}
		{
			dependencies: ["1000000000000002"]
			description: [
				"Fire is the oldest technology. The first rebellion against the dark."
				""
				"When you light your furnace, something stirs — not in the world, but in the knowledge buried beneath it. The principles of heat and transformation are older than any civilization."
				""
				"The old researchers understood this. Their first machines were little more than better furnaces. Yours can be too."
			]
			icon: "minecraft:furnace"
			id: "1000000000000003"
			rewards: [{
				id: "3000000000000003"
				type: "xp"
				xp: 100
			}]
			shape: "square"
			subtitle: "The oldest rebellion against the dark."
			tasks: [{
